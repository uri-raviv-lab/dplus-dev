# This Dockerfile is used to build manylinux wheels for the dplus-api package.
#
# After building, run the image to copy the generated wheels to your local machine.
# Replace <your-local-dir> with any directory you want the wheels to be saved in.
#
# Build:
#   docker build -f PythonInterface/Dockerfile.manylinux . -t dplus-api-manylinux:latest --build-arg GITHUB_VERSION=<version>
#
# Run and copy wheels:
#   docker run --rm --name dplus-api-manylinux -v <your-local-dir>:/external dplus-api-manylinux:latest
#
# Note: DO NOT PUSH THIS TO DockerHub — it's not meant to be a public image.

# ---------- Stage 1: Build C++ backend ----------
FROM nvidia/cuda:12.4.0-devel-ubuntu20.04 AS cplusplus

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install bash and necessary tools
RUN apt-get update && apt-get install -y \
    bash coreutils wget tzdata libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

# Set bash as the default shell
SHELL ["/bin/bash", "-c"]

# Install CMake
RUN mkdir -p /opt/cmake && \
    wget https://github.com/Kitware/CMake/releases/download/v3.22.2/cmake-3.22.2-linux-x86_64.sh && \
    bash cmake-3.22.2-linux-x86_64.sh --skip-license --prefix=/opt/cmake && \
    ln -s /opt/cmake/bin/cmake /usr/local/bin/cmake

# Prepare build directory
RUN mkdir -p /src/build

WORKDIR /src

# Copy C++ source files
COPY Backend /src/Backend
COPY BackendCommunication /src/BackendCommunication
COPY Common /src/Common
COPY Conversions /src/Conversions
COPY DebyeCalculator /src/DebyeCalculator
COPY pdbgen /src/pdbgen
COPY PDBManipulator /src/PDBManipulator
COPY PDBReaderLib /src/PDBReaderLib
COPY PDBUnits /src/PDBUnits
COPY Population /src/Population
COPY PropertySheets /src/PropertySheets
COPY backend_version.h /src
COPY CMakeLists.txt /src

# Build C++ backend
WORKDIR /src/build
RUN cmake .. && make

# Collect compiled output and required libs
RUN mkdir -p /output
RUN cp /src/build/Backend/lib* /output
RUN cp /usr/lib/x86_64-linux-gnu/libboost_system.so /output
RUN cp /usr/lib/x86_64-linux-gnu/libboost_filesystem.so /output
RUN cp /usr/local/cuda-12.4/targets/x86_64-linux/lib/libcurand.so.10 /output
RUN cp /usr/local/cuda-12.4/targets/x86_64-linux/lib/libcudart.so /output

# ---------- Stage 2: Build Python interface and wheels ----------
FROM quay.io/pypa/manylinux_2_28_x86_64 AS python

WORKDIR /src/PythonInterface

ARG GITHUB_VERSION
ENV GITHUB_VERSION=$GITHUB_VERSION

# Copy backend output and requirements
COPY --from=cplusplus /output /src/PythonInterface/lib
COPY ./PythonInterface/requirements.txt /src/PythonInterface/requirements.txt

# Install Python dependencies for multiple versions
RUN /opt/python/cp39-cp39/bin/pip install -r requirements.txt
RUN /opt/python/cp310-cp310/bin/pip install -r requirements.txt
RUN /opt/python/cp311-cp311/bin/pip install -r requirements.txt
RUN /opt/python/cp312-cp312/bin/pip install -r requirements.txt

# Copy Python and shared source files
COPY ./Backend /src/Backend
COPY ./Common /src/Common
COPY ./Conversions /src/Conversions
COPY ./PythonInterface /src/PythonInterface

# Build wheels for each Python version
RUN /opt/python/cp39-cp39/bin/python setup.py prepare
RUN /opt/python/cp39-cp39/bin/pip wheel .
RUN /opt/python/cp310-cp310/bin/pip wheel .
RUN /opt/python/cp311-cp311/bin/pip wheel .
RUN /opt/python/cp312-cp312/bin/pip wheel .

# Repair wheels using auditwheel
RUN mkdir /wheels
ENV LD_LIBRARY_PATH=/src/PythonInterface/dplus
RUN for whl in /src/PythonInterface/dplus_api*.whl; do \
    echo "Repairing: $whl"; \
    auditwheel repair "$whl" -w /wheels || echo "auditwheel failed for $whl"; \
done
# RUN find . -name "dplus_api*whl" -exec auditwheel repair {} -w /wheels \;

# MODIFIED ENTRYPOINT
# ENTRYPOINT [ "cp", "-r", "/wheels/.", "/external/dplus-api-wheels/"]
#CMD ["bash", "-c", "mkdir -p /external/dplus-api-wheels && cp -v /wheels/* /external/dplus-api-wheels/"]
CMD ["bash", "-c", "mkdir -p /external/dplus-api-wheels && cp -v /wheels/* /external/dplus-api-wheels/ || cp -v /src/PythonInterface/dplus_api*.whl /external/dplus-api-wheels/"]


